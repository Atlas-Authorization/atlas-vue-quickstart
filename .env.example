# Atlas auth — copy this file to .env and fill in your instance's values.
# Vite only exposes variables prefixed with VITE_ to the browser.
#
# The publishable key (safe to expose). Get one at https://atlasauth.net.
VITE_ATLAS_PUBLISHABLE_KEY=pk_test_xxx

# The instance's Frontend API origin.
VITE_ATLAS_FRONTEND_API=https://atlasauth.net
